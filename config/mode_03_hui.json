{
  "mode": 3,
  "service": "H-UI",
  "description": "H-UI 面板审查",
  "default_ports": [8081],
  "user_input_required": true,
  "default_ports_on_enter": true,
  "fingerprint": {
    "probes": [
      {
        "method": "POST",
        "path": "/hui/auth/login",
        "headers": {"Content-Type": "application/json"},
        "body": "{\"username\":\"test\",\"password\":\"test\"}",
        "match_type": "json_contains",
        "match_value": "accessToken"
      }
    ]
  },
  "template_index": 2
}
